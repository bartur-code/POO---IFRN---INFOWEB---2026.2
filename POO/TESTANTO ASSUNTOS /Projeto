class Horario:
    def __init__(self, id: int, data_hora: datetime, id_profissional: int, id_cliente: int = None):
        self.__id = id
        self.data_hora = data_hora
        self.__id_profissional = id_profissional
        self.__id_cliente = id_cliente

    # ID
    @property
    def id(self) -> int:
        return self.__id

    @id.setter
    def id(self, valor: int):
        self.__id = valor

    # Data e Hora
    @property
    def data_hora(self) -> datetime:
        return self.__data_hora

    @data_hora.setter
    def data_hora(self, valor: datetime):
        if valor.year < 2025:
            raise ValueError("A data do horário não pode ser anterior ao ano de 2025.")[cite: 1]
        self.__data_hora = valor

    # ID Profissional
    @property
    def id_profissional(self) -> int:
        return self.__id_profissional

    @id_profissional.setter
    def id_profissional(self, valor: int):
        self.__id_profissional = valor

    # ID Cliente
    @property
    def id_cliente(self) -> int:
        return self.__id_cliente

    @id_cliente.setter
    def id_cliente(self, valor: int):
        self.__id_cliente = valor

    def __str__(self):
        status = f"Agendado p/ Cliente ID {self.__id_cliente}" if self.__id_cliente else "Disponível"
        return f"Horario [ID: {self.__id}, Data/Hora: {self.__data_hora.strftime('%d/%m/%Y %H:%M')}, Profissional ID: {self.__id_profissional}, Status: {status}]"