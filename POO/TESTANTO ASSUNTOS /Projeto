from datetime import datetime

class Cliente:
    def __init__(self, id: int, nome: str, email: str, senha: str):
        self.__id = id
        self.nome = nome
        self.email = email
        self.senha = senha

    # ID
    @property
    def id(self) -> int:
        return self.__id

    @id.setter
    def id(self, valor: int):
        self.__id = valor

    # Nome
    @property
    def nome(self) -> str:
        return self.__nome

    @nome.setter
    def nome(self, valor: str):
        if not valor or not valor.strip():
            raise ValueError("O nome do cliente não pode ser vazio.")[cite: 1]
        self.__nome = valor.strip()

    # E-mail
    @property
    def email(self) -> str:
        return self.__email

    @email.setter
    def email(self, valor: str):
        if not valor or not valor.strip():
            raise ValueError("O e-mail do cliente não pode ser vazio.")[cite: 1]
        self.__email = valor.strip()

    # Senha
    @property
    def senha(self) -> str:
        return self.__senha

    @senha.setter
    def senha(self, valor: str):
        if not valor or not valor.strip():
            raise ValueError("A senha do cliente não pode ser vazia.")[cite: 1]
        self.__senha = valor.strip()

    def __str__(self):
        return f"Cliente [ID: {self.__id}, Nome: {self.__nome}, Email: {self.__email}]"


